{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kureedo",
  "compatibility_date": "2026-09-19",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [{ "pattern": "kureedo.mkpo.li", "custom_domain": true }]
}
